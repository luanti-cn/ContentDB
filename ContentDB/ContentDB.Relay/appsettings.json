{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Relay": {
    "Listen": "http://127.0.0.1:5180",
    "_InternalSecret_note": "与主后端 Relay__Secret 一致的长随机串;留空则拒绝所有分配。生产用环境变量 Relay__InternalSecret 注入,严禁沿用开发默认值。",
    "InternalSecret": "dev-relay-secret-123",
    "_PublicAddress_note": "对外公布的公网地址(客户端连接用),如 relay.luanti.cn;本地开发填 127.0.0.1",
    "PublicAddress": "127.0.0.1",
    "UdpBindAddress": "",
    "UdpPortStart": 20000,
    "UdpPortEnd": 25000,
    "MaxRooms": 500,
    "RegisterGraceSeconds": 30,
    "RoomIdleSeconds": 60,
    "GuestIdleSeconds": 30,
    "MaxGuestsPerRoom": 8,
    "RateLimitBytesPerSecond": 655360
  }
}
