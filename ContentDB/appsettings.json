{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "Host=localhost;Database=contentdb;Username=contentdb;Password=password",
    "MirrorDb": "Host=localhost;Database=contentdb_mirror;Username=contentdb;Password=password"
  },
  "Auth": {
    "FirstUserIsAdmin": true,
    "Oidc": {
      "Enabled": true,
      "Authority": "https://sso.example.com",
      "ClientId": "contentdb",
      "ClientSecret": "change-me",
      "Scopes": [ "openid", "profile", "email" ],
      "UsernameClaim": "preferred_username",
      "RequireHttpsMetadata": true,
      "CallbackPath": "/signin-oidc"
    }
  },
  "Mirror": {
    "_PublicBaseUrl_note": "留空 => 返回相对 URL(/thumbnails/... 、/uploads/...),前端同源经 Next 代理加载图片;Luanti 客户端相对本 API 主机解析同样可用。若前后端不同源部署,设为对外可达的镜像基础地址。",
    "PublicBaseUrl": "",
    "UpstreamTimeoutSeconds": 30,
    "ServeStaleOnUpstreamError": true,
    "ForwardUserAgent": true,
    "MetadataTtlSeconds": {
      "Packages": 300,
      "Updates": 300,
      "ForClient": 300,
      "Dependencies": 300,
      "Homepage": 300,
      "Tags": 3600,
      "Licenses": 3600,
      "ContentWarnings": 3600,
      "Default": 300
    }
  },
  "UpdateInfo": {
    "_note": "LuantiCN 客户端更新检查。发新版本时改这里;VersionCode = (主*1000+次)*1000+修订,大于客户端当前值才提示。",
    "Latest": {
      "Version": "5.18.0",
      "VersionCode": 5018000,
      "Url": "https://luanti.cn/download"
    }
  },
  "ServerList": {
    "_note": "客户端服务器列表(/serverlists)。Upstream 为官方 master(回源);本站收录的服务器会合并进 /serverlists/list。",
    "Upstream": "https://servers.luanti.org",
    "TtlSeconds": 60,
    "GeoipFallbackContinent": "AS",
    "LocalProtoMin": 39,
    "LocalProtoMax": 53,
    "LocalVersion": "5.18.0",
    "LocalGameId": "luanticn"
  },
  "SourceSites": {
    "_note": "多源:本站(Local)恒排最前;各上游(Upstreams)按 Order 升序在后。Luanti 客户端会在简介前加 Label。后续新增站点只需在 Upstreams 里追加。",
    "Local": {
      "Id": "local",
      "Name": "本站",
      "Label": "[Luanti.cn]"
    },
    "Upstreams": [
      {
        "Id": "luanti-org",
        "Name": "Luanti.org",
        "Label": "[Luanti.org]",
        "BaseUrl": "https://content.luanti.org",
        "Enabled": true,
        "Order": 100,
        "TimeoutSeconds": 0
      }
    ]
  },
  "Vault": {
    "_EncryptionKey_note": "AES-256-GCM 密钥(32 字节的 base64)。生产必须用环境变量 Vault__EncryptionKey 或 User Secrets 注入;更换后已存的服务器密码无法解密。",
    "EncryptionKey": "",
    "PairingCodeTtlMinutes": 10,
    "MaxDevicesPerUser": 20,
    "MaxVaultEntriesPerUser": 200
  },
  "Relay": {
    "_note": "联机中继(P2P 打洞失败兜底)。单节点用平铺字段;多节点横向扩展用 Nodes 数组(按房间分片,节点故障时 Host 心跳失败自动换节点重注册),Nodes 非空时忽略平铺字段。",
    "Enabled": false,
    "BaseUrl": "http://127.0.0.1:5180",
    "Secret": "",
    "PublicHost": "",
    "Nodes": [
      {
        "Name": "relay-bj-1",
        "BaseUrl": "http://10.0.0.5:5180",
        "Secret": "",
        "PublicHost": "relay-bj.luanti.cn"
      }
    ]
  },
  "Storage": {
    "ServiceUrl": "https://cos.ap-guangzhou.myqcloud.com",
    "Region": "ap-guangzhou",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "luanti-test-1368273232",
    "ForcePathStyle": false,
    "PublicUrlBase": null,
    "UsePresignedUrls": true,
    "PresignedUrlExpirySeconds": 3600,
    "PresignedPublicHost": null,
    "ProxyDownloads": true
  }
}
