<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c6c39a7f-6e34-44c4-b2c3-3c293718428f</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <!-- 关闭 XML 文档生成 + OpenAPI XML 注释源生成器,规避其与 Microsoft.OpenApi 2.0.0 的已知不兼容(CS0200) -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OpenApiGenerateDocumentationComments>false</OpenApiGenerateDocumentationComments>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.7.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ContentDB.Core\ContentDB.Core.csproj" />
    <ProjectReference Include="ContentDB.Infrastructure\ContentDB.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    本 Web 项目位于解决方案根目录,类库在其子文件夹内。
    需将子项目文件夹排除出 Web SDK 的默认源码/内容通配,
    否则会重复编译类库源码及其 obj 下的 AssemblyInfo(导致 CS0436/CS0579)。
  -->
  <ItemGroup>
    <Compile Remove="ContentDB.Core\**\*.cs" />
    <Compile Remove="ContentDB.Infrastructure\**\*.cs" />
    <Compile Remove="ContentDB.Relay\**\*.cs" />
    <Content Remove="ContentDB.Core\**" />
    <Content Remove="ContentDB.Infrastructure\**" />
    <Content Remove="ContentDB.Relay\**" />
    <EmbeddedResource Remove="ContentDB.Core\**" />
    <EmbeddedResource Remove="ContentDB.Infrastructure\**" />
    <EmbeddedResource Remove="ContentDB.Relay\**" />
    <None Remove="ContentDB.Core\**" />
    <None Remove="ContentDB.Infrastructure\**" />
    <None Remove="ContentDB.Relay\**" />
  </ItemGroup>

</Project>
