# C# 镜像后端地址(next.config.mjs 的反向代理目标 / SSR 直连地址)
BACKEND_ORIGIN=https://api.luanti.cn

# 可选:让浏览器直接请求绝对 API 地址(留空则走同源 + rewrites 代理,避免 CORS)
# NEXT_PUBLIC_API_BASE=https://api.luanti.cn

# 实时通讯 WebSocket(网页聊天/在线状态)。
# 留空 = 同源 ws(s)://当前域名/api/cloud/client/ws/(需反向代理支持 Upgrade,如 Nginx)。
# 本地开发:Next 的 middleware 代理不支持 WebSocket,直连后端端口。
# NEXT_PUBLIC_WS_URL=ws://localhost:5175
