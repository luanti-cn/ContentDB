# 复制为 .env 并填入真实值(.env 不进 git)

# 数据库密码
POSTGRES_PASSWORD=change-me-strong-password

# 保管库加密密钥:openssl rand -base64 32 生成;一旦使用切勿更换
VAULT_ENCRYPTION_KEY=

# 对象存储(腾讯云 COS / Cloudflare R2 / MinIO)
STORAGE_SERVICEURL=https://cos.ap-guangzhou.myqcloud.com
STORAGE_REGION=ap-guangzhou
STORAGE_ACCESSKEY=
STORAGE_SECRETKEY=
STORAGE_BUCKET=luanticn
